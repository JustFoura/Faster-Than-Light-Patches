+
+    // Optional page-cache release after the node. On host-offloaded MoE models
+    // the routed expert working set is far larger than the RAM left for the
+    // page cache, so leaving pages to the LRU makes each ubatch re-fault the
+    // same ranges several times. Dropping the routed expert pages once every
+    // thread is done keeps the cache bounded and turns the next pass into one
+    // clean stream. Only file-backed shared ranges are ever madvise'd: for a
+    // private anonymous mapping MADV_DONTNEED would zero the data.
+    ggml_barrier(params->threadpool);
+    if (ith == 0 && ggml_cpu_mmid_page_release_enabled()) {
+        const long pg = sysconf(_SC_PAGESIZE);
+        if (pg > 0 && ggml_cpu_range_is_file_backed(src0->data, (size_t) (src0->nb[2] * n_as))) {
+            for (int cur_a = 0; cur_a < n_as; ++cur_a) {
+                if (matrix_row_counts[cur_a] == 0) {
+                    continue;
+                }
+                char * p = (char *) src0->data + cur_a * nb02;
+                char * pb = (char *) ((uintptr_t) p & ~(uintptr_t) (pg - 1));
+                madvise((void *) pb, (size_t) (p - pb) + (size_t) nb02, MADV_DONTNEED);
+            }
+        }
+    }
