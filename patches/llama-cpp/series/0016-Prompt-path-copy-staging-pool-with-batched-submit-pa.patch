+            ggml_vk_ensure_sync_staging_buffer(ctx, staging_size);
+        }
+        vk_buffer staging = pooled ? ctx->copy_pool[slot].buf : ctx->sync_staging;
+
         ggml_vk_sync_buffers(nullptr, cpy_ctx);
 
         std::vector<vk::BufferCopy> slices(1);
@@ -17357,15 +17578,27 @@ static void ggml_backend_vk_set_tensor_2d_async(ggml_backend_t backend, ggml_ten
             }
         }
 
-        cpy_ctx->s->buffer->buf.copyBuffer(ctx->sync_staging->buffer, buf->buffer, slices);
+        cpy_ctx->s->buffer->buf.copyBuffer(staging->buffer, buf->buffer, slices);
 
         if (size == stride_data) {
-            deferred_memcpy(ctx->sync_staging->ptr, data, staging_size, &cpy_ctx->in_memcpys);
+            deferred_memcpy(staging->ptr, data, staging_size, &cpy_ctx->in_memcpys);
         } else {
             for (size_t i = 0; i < n_copies; i++) {
-                deferred_memcpy((uint8_t *)ctx->sync_staging->ptr + i * size, (const uint8_t *)data + i * stride_data, size, &cpy_ctx->in_memcpys);
+                deferred_memcpy((uint8_t *)staging->ptr + i * size, (const uint8_t *)data + i * stride_data, size, &cpy_ctx->in_memcpys);
             }
         }
+
+        if (pooled) {
+            // Stage into the slot and keep going. The batch is pushed to the
+            // GPU when it fills, when a slot is needed, or before compute that
+            // reads a staged tensor — one submit and one fence for many
+            // copyBuffers, instead of one round trip per copy.
+            if (ctx->copy_batch.size() >= ctx->copy_batch_max) {
+                ggml_vk_copy_pool_flush(ctx);
+            }
+            return;
+        }
+
         // Staging fallback: the host->staging copy above is only *recorded* into
         // in_memcpys; it runs in ggml_vk_synchronize's drain. That call then
         // blocks on the GPU fence, so with one staging buffer this path paces the
@@ -17526,6 +17759,8 @@ static void ggml_vk_synchronize(ggml_backend_vk_context * ctx) {
 
     bool do_transfer = !ctx->compute_ctx.expired();
 
+    // Push any staged-but-unsubmitted copy batch before anything can read it.
+    ggml_vk_copy_pool_flush(ctx);
     if (ggml_vk_submit_transfer_ctx(ctx)) {
         ctx->submit_pending = true;
     }
@@ -18277,6 +18512,7 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
     bool first_node_in_batch = true; // true if next node will be first node in a batch
     int submit_node_idx = 0; // index to first node in a batch
 
+    ggml_vk_copy_pool_flush(ctx);
     ggml_vk_submit_transfer_ctx(ctx);
 
