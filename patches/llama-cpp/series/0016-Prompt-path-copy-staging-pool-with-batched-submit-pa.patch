+// ---- prompt-path copy staging pool (2026-10-02) ----------------------------
+// LLAMA_VK_COPY_POOL=<n> gives the scheduler's host->device expert weight
+// copies n staging slots instead of one. Upstream ends every such copy with
+// ggml_vk_synchronize(), which spin-waits on the GPU fence, so copy N+1 cannot
+// start reading until copy N's copyBuffer has been consumed: one copy deep,
+// host reads and GPU work strictly alternating. With a pool, acquiring a slot
+// waits only on THAT slot's fence, so the host read for copy N+1 proceeds while
+// the GPU is still draining copies N-k..N.
+static bool ggml_vk_copy_pool_enabled() {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char * e = getenv("LLAMA_VK_COPY_POOL");
+        enabled = (e && e[0]) ? atoi(e) : 0;
+    }
+    return enabled > 1;
+}
+
+static int ggml_vk_copy_pool_size() {
+    static int n = -1;
+    if (n < 0) {
+        const char * e = getenv("LLAMA_VK_COPY_POOL");
+        n = (e && e[0]) ? atoi(e) : 0;
+        if (n > 32) {
+            n = 32;
+        }
+    }
+    return n;
+}
+
+static long g_copy_pool_acquires = 0, g_copy_pool_blocked = 0, g_copy_pool_batches = 0;
+
+static void ggml_vk_copy_pool_init(ggml_backend_vk_context * ctx) {
+    const int n = ggml_vk_copy_pool_size();
+    ctx->copy_pool.resize(n);
+    for (int i = 0; i < n; i++) {
+        ctx->copy_pool[i].buf   = nullptr;
+        ctx->copy_pool[i].busy  = false;
+    }
+    ctx->copy_pool_next = 0;
+    ctx->copy_batch.clear();
+    ctx->copy_inflight.clear();
+    // Half the slots per batch, so one batch is being read from the host while
+    // the GPU drains the other. A batch of 1 degenerates to the per-copy submit
+    // this replaces.
+    ctx->copy_batch_max = n / 2 > 0 ? (size_t) (n / 2) : 1;
+    if (getenv("LLAMA_VK_COPY_POOL_LOG")) {
+        fprintf(stderr, "[copy-pool] slots=%d batch=%zu\n", n, ctx->copy_batch_max);
+    }
+}
+
+static void ggml_vk_copy_pool_destroy(ggml_backend_vk_context * ctx) {
+    if (ctx->copy_pool.empty()) {
+        return;
+    }
+    // Retire everything still outstanding before the slots go away.
+    ggml_vk_copy_pool_flush(ctx);
+    while (!ctx->copy_inflight.empty()) {
+        ggml_vk_copy_pool_retire_oldest(ctx);
+    }
+    if (getenv("LLAMA_VK_COPY_POOL_LOG")) {
+        fprintf(stderr, "[copy-pool] acquires=%ld blocked=%ld batches=%ld avg_batch=%.1f slots=%zu\n",
+                g_copy_pool_acquires, g_copy_pool_blocked, g_copy_pool_batches,
+                g_copy_pool_batches ? (double) g_copy_pool_acquires / g_copy_pool_batches : 0.0,
+                ctx->copy_pool.size());
+    }
+    for (auto & s : ctx->copy_pool) {
+        ggml_vk_destroy_buffer(s.buf);
+        s.buf = nullptr;
+    }
+    ctx->copy_pool.clear();
+}
+
+// Retire the oldest in-flight batch: wait its fence, free its slots. This is
+// the ONLY place the copy path blocks, and it blocks on the batch the GPU has
+// had longest to finish — not on the copy it just issued.
+static void ggml_vk_copy_pool_retire_oldest(ggml_backend_vk_context * ctx) {
+    if (ctx->copy_inflight.empty()) {
+        return;
+    }
+    ggml_backend_vk_context::staging_batch & b = ctx->copy_inflight.front();
+    VK_CHECK(ctx->device->device.waitForFences({ b.fence }, true, UINT64_MAX),
+             "copy-pool batch fence", ctx->device);
+    ctx->device->device.resetFences({ b.fence });
+    ctx->device->device.destroyFence(b.fence);
+    for (size_t s : b.slots) {
+        ctx->copy_pool[s].busy = false;
+    }
+    ctx->copy_inflight.erase(ctx->copy_inflight.begin());
+}
+
+// Push the open batch to the GPU: drain the host reads, then ONE submit with
+// ONE fence covering every slot in the batch. Must be called before any compute
+// that reads a staged tensor — compute waits on transfer_semaphore, which only
+// advances on submit.
+static void ggml_vk_copy_pool_flush(ggml_backend_vk_context * ctx) {
+    if (ctx->copy_batch.empty()) {
+        return;
+    }
+    vk::Fence fence = ctx->device->device.createFence({});
+    ctx->copy_inflight.push_back({ fence, ctx->copy_batch });
+    ctx->copy_batch.clear();
+    g_copy_pool_batches++;
+
+    if (!ggml_vk_submit_transfer_ctx(ctx, fence)) {
+        // Nothing was submitted: the recorded copyBuffers would never run.
+        // Fall back to the synchronous path so the data still lands.
+        ctx->copy_inflight.pop_back();
+        ctx->device->device.destroyFence(fence);
+        ggml_vk_synchronize(ctx);
+    }
+}
+
+// Guarantee at least one free slot, blocking only when every slot is spoken
+// for. MUST be called before the caller takes a vk_context: flushing ends the
+// open transfer command buffer, so doing it while one is live would leave the
+// caller recording into a command buffer that has already been ended.
+static void ggml_vk_copy_pool_reserve(ggml_backend_vk_context * ctx) {
+    const size_t n = ctx->copy_pool.size();
+    for (int guard = 0; guard < 64; guard++) {
+        for (size_t i = 0; i < n; i++) {
+            if (!ctx->copy_pool[(ctx->copy_pool_next + i) % n].busy) {
+                return;
+            }
+        }
+        g_copy_pool_blocked++;
+        // Retire the OLDEST in-flight batch: by the time we need a slot, that is
+        // the one the GPU has had longest to drain. This wait is the only place
+        // the copy path blocks, and it is what the pool exists to amortize.
+        ggml_vk_copy_pool_flush(ctx);
+        ggml_vk_copy_pool_retire_oldest(ctx);
+    }
+    GGML_ABORT("ggml_vk_copy_pool_reserve: no free slot after retiring every batch");
+}
+
+// Claim a free slot (ggml_vk_copy_pool_reserve guarantees one exists) and add
+// it to the open batch. Does not submit, so it is safe to call with a live
+// command buffer.
+static size_t ggml_vk_copy_slot_take(ggml_backend_vk_context * ctx) {
+    const size_t n = ctx->copy_pool.size();
+    g_copy_pool_acquires++;
+    for (size_t i = 0; i < n; i++) {
+        const size_t k = (ctx->copy_pool_next + i) % n;
+        if (!ctx->copy_pool[k].busy) {
+            ctx->copy_pool_next = (k + 1) % n;
+            ctx->copy_pool[k].busy = true;
+            ctx->copy_batch.push_back(k);
+            return k;
+        }
+    }
+    GGML_ABORT("ggml_vk_copy_slot_take: no free slot");
+}
+
 // Submit any pending transfer queue work and signal the transfer semaphore.
 // The next compute context created via ggml_vk_get_compute_ctx will wait on this semaphore.
