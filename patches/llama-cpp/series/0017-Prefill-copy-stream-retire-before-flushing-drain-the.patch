-        // the copy path blocks, and it is what the pool exists to amortize.
-        ggml_vk_copy_pool_flush(ctx);
-        ggml_vk_copy_pool_retire_oldest(ctx);
+        // Retire the OLDEST in-flight batch FIRST, and only submit the open batch
+        // when there is nothing left in flight to reclaim.
+        //
+        // Order matters. The previous order was flush-then-retire: at the moment
+        // the pool runs dry, copy_batch holds exactly one un-submitted slot, so
+        // the flush pushed it as a ONE-member batch before reclaiming anything.
+        // That pins the batch size at 1 for every reclaim, which is why the
+        // 10-02 run measured avg_batch 1.1 and blocked 12,632 of 13,716 acquires
+        // — the batch was being destroyed by its own recovery path, not by
+        // anything the caller did. Retiring first lets the open batch keep
+        // accumulating up to copy_batch_max before it is submitted.
+        if (!ctx->copy_inflight.empty()) {
