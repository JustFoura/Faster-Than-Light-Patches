+// Run one batch's deferred host->staging reads.
+//
+// Sequentially this is a queue-depth-1 fault stream: one memcpy at a time, each
+// blocking on its own page faults. The batch already holds up to copy_batch_max
+// INDEPENDENT copies (each targets its own staging slot), so running them
+// concurrently multiplies the number of readahead streams the kernel and the
+// drive have in flight. Same bytes into the same staging buffers, so the upload
+// is unchanged.
+//
+// LLAMA_VK_COPY_DRAIN_THREADS=<n>: 1 restores the sequential drain. Default 8.
+static void ggml_vk_drain_memcpys(std::vector<vk_staging_memcpy> & memcpys) {
+    static int nthreads = -1;
+    if (nthreads < 0) {
+        const char * e = getenv("LLAMA_VK_COPY_DRAIN_THREADS");
+        nthreads = e && e[0] ? atoi(e) : 8;
+        if (nthreads < 1) {
+            nthreads = 1;
+        }
+        if (nthreads > 32) {
+            nthreads = 32;
+        }
+    }
+
+    auto drain_one = [](vk_staging_memcpy & cpy) {
+        if (!ggml_vk_pread_parallel(cpy.src, cpy.dst, cpy.n)) {
+            memcpy(cpy.dst, cpy.src, cpy.n);
+        }
+    };
+
+    const int n = (int) memcpys.size();
+    if (n <= 1 || nthreads <= 1) {
+        for (auto & cpy : memcpys) {
+            drain_one(cpy);
+        }
+        return;
+    }
+
+    const int nt = n < nthreads ? n : nthreads;
+    std::vector<std::thread> workers;
+    workers.reserve(nt - 1);
+    for (int t = 1; t < nt; ++t) {
+        workers.emplace_back([&memcpys, drain_one, t, nt]() {
+            for (int i = t; i < (int) memcpys.size(); i += nt) {
+                drain_one(memcpys[i]);
+            }
+        });
+    }
+    for (int i = 0; i < (int) memcpys.size(); i += nt) {
+        drain_one(memcpys[i]);
+    }
+    for (auto & w : workers) {
+        w.join();
+    }
+}
+
