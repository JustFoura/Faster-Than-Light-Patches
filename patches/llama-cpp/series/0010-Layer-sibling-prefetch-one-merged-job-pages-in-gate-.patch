From b22bc112988293c7dd9731bf7ce36a60a2d40f62 Mon Sep 17 00:00:00 2001
From: JustFoura <JustFoura.dev@proton.me>
Date: Tue, 29 Sep 2026 20:50:25 +1300
Subject: [PATCH 10/18] Layer-sibling prefetch: one merged job pages in
 gate+up+down slices for the layer's shared miss set

The three ffn_{gate,up,down}_exps ops of a layer route identically, so the
first op's job now includes the registered siblings' slices (page-rounded,
same cur_a set) - one deep pread per layer (~7.8 MB, queue ~8) instead of
three serial ~2.2 MB waits. Later ops of the layer re-pread from page cache
(no disk); their sequencing wait collapses to a cache copy. Registry keyed
by block index parsed from the tensor name, thread 0 only, between barriers.
---
 ggml/src/ggml-cpu/ggml-cpu.c | 48 +++++++++++++++++++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index de6c75d4b..26d80113f 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -2325,8 +2325,35 @@ static void ggml_compute_forward_mul_mat_id(
         const long pg = sysconf(_SC_PAGESIZE);
         struct ggml_moe_fanout_slice * sl = NULL;
         int n_sl = 0;
+        // Layer-sibling prefetch registry: the three ffn_{gate,up,down}_exps
+        // mul_mat_id ops of a layer share the same routed experts, so one
+        // job can page in all three tensors' slices for this ubatch's miss
+        // set - one deep wait per layer instead of three serial ones. Ops
+        // register themselves by name as they stream by; a layer's later ops
+        // see earlier ops and merge them (their slices then come from page
+        // cache, not disk). Keyed by block index parsed from the tensor name;
+        // written and read only by thread 0 between barriers.
+        struct sib_ent { const void * base; size_t nb02; int has; };
+        #define GGML_MOE_SIB_LAYERS 64
+        static struct sib_ent g_moe_sib[GGML_MOE_SIB_LAYERS][3];
+        int sib_il = -1, sib_kind = -1;
+        {
+            const char * nm = src0->name;
+            const char * blk = strstr(nm, "blk.");
+            if (blk) {
+                sib_il = atoi(blk + 4);
+                if (strstr(nm, "ffn_gate_exps")) sib_kind = 0;
+                else if (strstr(nm, "ffn_up_exps")) sib_kind = 1;
+                else if (strstr(nm, "ffn_down_exps")) sib_kind = 2;
+            }
+            if (sib_il >= 0 && sib_il < GGML_MOE_SIB_LAYERS && sib_kind >= 0) {
+                g_moe_sib[sib_il][sib_kind].base = src0->data;
+                g_moe_sib[sib_il][sib_kind].nb02 = (size_t) nb02;
+                g_moe_sib[sib_il][sib_kind].has = 1;
+            }
+        }
         if (moe_fanout_n > 0) {
-            sl = malloc(sizeof(struct ggml_moe_fanout_slice) * (size_t) n_as);
+            sl = malloc(sizeof(struct ggml_moe_fanout_slice) * (size_t) n_as * 3);
             if (sl) {
                 for (int cur_a = 0; cur_a < n_as; ++cur_a) {
                     if (matrix_row_counts[cur_a] == 0) {
@@ -2338,6 +2365,25 @@ static void ggml_compute_forward_mul_mat_id(
                     moe_node_bytes += sl[n_sl].n;
                     n_sl++;
                 }
+                // merge registered same-layer siblings (own slices are first;
+                // sibling slices prefetch ahead of that op's compute)
+                if (sib_il >= 0 && sib_il < GGML_MOE_SIB_LAYERS && sib_kind >= 0) {
+                    for (int k = 0; k < 3; ++k) {
+                        if (k == sib_kind || !g_moe_sib[sib_il][k].has) {
+                            continue;
+                        }
+                        for (int cur_a = 0; cur_a < n_as; ++cur_a) {
+                            if (matrix_row_counts[cur_a] == 0) {
+                                continue;
+                            }
+                            char * p = (char *) g_moe_sib[sib_il][k].base + cur_a * g_moe_sib[sib_il][k].nb02;
+                            sl[n_sl].p = (char *) ((uintptr_t) p & ~(uintptr_t) (pg - 1));
+                            sl[n_sl].n = g_moe_sib[sib_il][k].nb02 + (size_t) (p - sl[n_sl].p);
+                            moe_node_bytes += sl[n_sl].n;
+                            n_sl++;
+                        }
+                    }
+                }
             }
         }
         if (n_sl > 0) {
-- 
