@@ -1461,7 +1465,7 @@ UseGgmlGemm2:;
 
 // ggml_compute_forward_mul_mat_id
 
-#define MMID_MATRIX_ROW(row_id, i1) matrix_rows[(row_id)*ids->ne[0]*ids->ne[1] + (i1)]
+#define MMID_MATRIX_ROW(i1) matrix_rows[(i1)]
 
 struct mmid_row_mapping {
     int32_t i1;
@@ -1473,7 +1477,6 @@ static void ggml_compute_forward_mul_mat_id_one_chunk(
     const struct ggml_tensor * src0,
     const struct ggml_tensor * src1,
     const struct ggml_tensor * ids,
-    const int64_t cur_a,
     const int64_t ir0_start,
     const int64_t ir0_end,
     const int64_t ir1_start,
@@ -1496,12 +1499,69 @@ static void ggml_compute_forward_mul_mat_id_one_chunk(
 
     float tmp[16];
 
+    // Experimental prompt path: reuse each packed IQ4 weight row across four
+    // routed token rows. The default ggml dot kernels intentionally handle one
+    // RHS at a time; this path trades small stack scratch for fewer rereads of
+    // the expert row. Keep it opt-in until output and full-prompt A/B checks.
+    const char * multi_rhs_env = getenv("GGML_MOE_Q4_MULTI_RHS");
+    if (multi_rhs_env && multi_rhs_env[0] == '1' &&
+        (type == GGML_TYPE_IQ4_XS || type == GGML_TYPE_IQ4_NL) &&
+        (vec_dot_type == GGML_TYPE_Q8_K || vec_dot_type == GGML_TYPE_Q8_0) &&
+        ir1_end - ir1_start >= 4) {
+#if defined(_MSC_VER) || defined(__MINGW32__)
+        float * weight_f32 = (float *) _alloca((size_t) ne00 * sizeof(float));
+        float * rhs_f32    = (float *) _alloca((size_t) 4 * ne00 * sizeof(float));
+#else
+        float * weight_f32 = (float *) alloca((size_t) ne00 * sizeof(float));
+        float * rhs_f32    = (float *) alloca((size_t) 4 * ne00 * sizeof(float));
+#endif
+        const struct ggml_type_traits * weight_traits = ggml_get_type_traits(type);
+        const struct ggml_type_traits * rhs_traits    = ggml_get_type_traits(vec_dot_type);
+        GGML_ASSERT(weight_traits->to_float != NULL);
+        GGML_ASSERT(vec_dot_type != GGML_TYPE_Q8_K || !rhs_traits->to_float);
+        GGML_ASSERT(vec_dot_type == GGML_TYPE_Q8_K || rhs_traits->to_float != NULL);
+
+        for (int64_t first = ir1_start; first < ir1_end; first += 4) {
+            const int64_t n_rhs = MIN(4, ir1_end - first);
+            struct mmid_row_mapping routes[4];
+
+            // Convert the routed activations once; reuse them for every output
+            // row in this tile. wdata is the existing Q8 conversion workspace.
+            for (int64_t r = 0; r < n_rhs; ++r) {
+                routes[r] = MMID_MATRIX_ROW(first + r);
+                const int64_t i11 = routes[r].i1 % ne11;
+                const int64_t i12 = routes[r].i2;
+                const void * rhs_row = (src1_cont || src1->type != vec_dot_type)
+                    ? (const char *) wdata + (i11 + i12*ne11)*row_size
+                    : (const char *) src1->data + i11*nb11 + i12*nb12;
+                if (vec_dot_type == GGML_TYPE_Q8_K) {
+                    dequantize_row_q8_K((const block_q8_K *) rhs_row, rhs_f32 + r*ne00, ne00);
+                } else {
+                    rhs_traits->to_float(rhs_row, rhs_f32 + r*ne00, ne00);
+                }
+            }
+
