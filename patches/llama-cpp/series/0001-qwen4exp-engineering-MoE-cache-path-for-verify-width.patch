     const int32_t * target_layer_ids   = nullptr; // model_dft's extract layer indices
     uint32_t        target_layer_ids_n = 0;
 
+    // per-seq position offset when the draft context is smaller than the target
+    // context: draft positions are shifted down by this amount and positions
+    // that fall out of the draft window are dropped
+    std::vector<llama_pos> pos_offset;
+    std::vector<llama_pos> p_abs_last; // per-seq last injected absolute target position (restart detector)
+
     common_speculative_impl_draft_dflash(const common_params_speculative & params, uint32_t n_seq,
             common_speculative_type type = COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH)
         : common_speculative_impl(type, n_seq, params.draft.n_max)
@@ -951,6 +957,9 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
         auto * ctx_dft = this->params.ctx_dft;
         GGML_ASSERT(ctx_tgt && ctx_dft && "DFlash requires ctx_tgt and ctx_dft to be set");
 
+        pos_offset.assign(n_seq, 0);
+        p_abs_last.assign(n_seq, 0);
+
         const llama_model * model_dft = llama_get_model(ctx_dft);
         const llama_model * model_tgt = llama_get_model(ctx_tgt);
 
@@ -1131,9 +1140,42 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
             }
             const int32_t n_rows = i_batch_end[seq_id] - i_batch_beg[seq_id] + 1;
 
+            // a sequence whose absolute positions dropped below what we already
+            // injected restarted (new conversation on the slot, or a rollback).
+            // The stored remap is bound to the old timeline: start the window
+            // over from zero or the stored positions go negative, which the
+            // batch validator rejects outright.
+            const llama_pos p_first_abs = batch_in.pos[i_batch_beg[seq_id]];
+            if (p_first_abs < p_abs_last[seq_id]) {
+                llama_memory_seq_rm(llama_get_memory(ctx_dft), seq_id, -1, -1);
+                pos_offset[seq_id] = 0;
+            }
+            p_abs_last[seq_id] = batch_in.pos[i_batch_end[seq_id]];
+
             for (int32_t offset = 0; offset < n_rows; offset += n_ubatch) {
                 const int32_t n_chunk = std::min(n_ubatch, n_rows - offset);
 
+                // when the draft context is smaller than the target context,
+                // slide the draft window. The draft's stored positions are
+                // target positions minus pos_offset, so a slide moves the
+                // coordinate origin: drop cells stored below the new origin
+                // (their absolute positions fell out of the window) and drop
+                // cells at or above the incoming chunk's first stored position
+                // (their stored spots collide with the new writes). The draft
+                // loses at most one ubatch of recent context per slide.
+                // Chunks are far smaller than the window, so a chunk never
+                // straddles the boundary.
+                const llama_pos p_last = batch_in.pos[i_batch_beg[seq_id] + offset + n_chunk - 1];
+                const int32_t dft_cap  = (int32_t) llama_n_ctx_seq(ctx_dft) - this->n_max - 4;
+                if (p_last - pos_offset[seq_id] >= dft_cap) {
+                    const llama_pos new_off   = (llama_pos) (p_last - dft_cap);
+                    const llama_pos inject_beg = (llama_pos) (batch_in.pos[i_batch_beg[seq_id] + offset] - new_off);
+                    llama_memory_t mem_dft = llama_get_memory(ctx_dft);
+                    llama_memory_seq_rm(mem_dft, seq_id, -1, new_off - pos_offset[seq_id]);
+                    llama_memory_seq_rm(mem_dft, seq_id, inject_beg, -1);
+                    pos_offset[seq_id] = new_off;
+                }
+
                 // gather target features per extract layer; the fused decode encodes and
                 // injects them into the K/V cache at the target positions
                 batch_inject.n_tokens = n_chunk;
@@ -1151,10 +1193,10 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
 
                 for (int32_t i = 0; i < n_chunk; ++i) {
                     const llama_pos p = batch_in.pos[i_batch_beg[seq_id] + offset + i];
-                    batch_inject.pos[i] = p;
+                    batch_inject.pos[i] = p - pos_offset[seq_id];
                     if (is_mrope) {
-                        batch_inject.pos[1 * n_chunk + i] = p;
-                        batch_inject.pos[2 * n_chunk + i] = p;
+                        batch_inject.pos[1 * n_chunk + i] = p - pos_offset[seq_id];
+                        batch_inject.pos[2 * n_chunk + i] = p - pos_offset[seq_id];
                         batch_inject.pos[3 * n_chunk + i] = 0;
                     }
                     batch_inject.n_seq_id[i]  = 1;
@@ -1189,9 +1231,16 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
                 continue;
             }
 
+            // trim the draft cache to the accepted prefix in STORED coordinates;
+            // the framework's own trim runs in absolute space and cannot see the remap,
+            // leaving stale cells above the next noise block
+            if (pos_offset[seq_id] > 0) {
+                llama_memory_seq_rm(llama_get_memory(ctx_dft), seq_id, (llama_pos)(dp.n_past - pos_offset[seq_id]), -1);
+            }
+
             common_sampler_reset(smpls[seq_id].get());
 
-            const int32_t n = (int32_t) dp.n_past;
+            const int32_t n = (int32_t) dp.n_past - pos_offset[seq_id];
 
             const int32_t n_draft = params.n_max;
 
@@ -1414,7 +1463,13 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         llama_set_embeddings_nextn(ctx_tgt, true, /*masked*/ false);
         llama_set_embeddings_nextn(ctx_dft, true, /*masked*/ true);
 
-        is_mem_shared = llama_get_ctx_other(ctx_dft) == ctx_tgt;
+        // ctx_other is required by qwen4exp for graph building (the draft reads
+        // the target trunk), but the same-position draft convention is only
+        // valid for archs whose draft shares the target KV (gemma4-assistant).
+        // Everything else owns its KV and drafts at sequential positions.
+        char arch_name[64] = {0};
+        llama_model_meta_val_str(llama_get_model(ctx_dft), "general.architecture", arch_name, sizeof(arch_name));
+        is_mem_shared = llama_get_ctx_other(ctx_dft) == ctx_tgt && std::strcmp(arch_name, "gemma4-assistant") == 0;
         chain_heads   = n_mtp_layers > 1 && !is_mem_shared;
 
         if (chain_heads) {
@@ -2529,8 +2584,10 @@ common_speculative_init_result::common_speculative_init_result(
         cparams.ctx_type = LLAMA_CONTEXT_TYPE_MTP;
     }
 
-    // the draft context holds as many tokens per sequence as the target context
-    cparams.n_ctx = llama_n_ctx(ctx_tgt);
+    // the draft context holds as many tokens per sequence as the target context,
+    // unless a smaller draft context was requested (--spec-draft-ctx)
+    cparams.n_ctx = params.speculative.draft.n_ctx > 0 ?
+        (uint32_t) params.speculative.draft.n_ctx : llama_n_ctx(ctx_tgt);
 
     // note: for small models maybe we can set this to the maximum possible draft from all speculative types
     //       the extra memory for small models is likely negligible?
