 // threads touch one byte per page of each slice the op will compute, forcing
 // synchronous faults in N concurrent streams instead of relying on async
 // readahead. 0 restores the passive MADV_WILLNEED kick.
+//
+// LLAMA_MOE_FANOUT_ASYNC=1 (default): the workers live in a persistent pool
+// created on first use and each op only submits its slice list — the compute
+// threads start immediately and fault on demand for slices the pool has not
+// reached yet, so page-in overlaps compute within the node and trails into the
+// next nodes. Submission applies backpressure on a small job ring: a slot is
+// only reused once every pool worker has passed it, which keeps each worker's
+// view of the ring consistent and bounds the submitter's wait. =0 restores the
+// per-op spawn/join fanout (touch-then-compute).
 static atomic_int ggml_moe_fanout_sink = 0;
 
 struct ggml_moe_fanout_slice { char * p; size_t n; };
@@ -1676,46 +1685,194 @@ static const struct ggml_moe_pread_file * ggml_moe_pread_resolve(const void * ad
     return NULL;
 }
 
+// page in one slice: exact-size pread when a model mapping was resolved,
+// else a one-byte-per-page touch walk to fault it in.
+static void ggml_moe_fanout_touch_slice(const struct ggml_moe_fanout_slice * s,
+        long pg, const struct ggml_moe_pread_file * pf,
+        char ** scratch, size_t * scratch_n) {
+    const char * p = s->p;
+    const size_t n = s->n;
+    if (pf) {
+        off_t off = pf->map_off + (p - (const char *) pf->map_start);
+        if (*scratch_n < n) {
+            free(*scratch);
+            *scratch = (char *) malloc(n);
+            *scratch_n = *scratch ? n : 0;
+        }
+        if (*scratch) {
+            size_t got = 0;
+            while (got < n) {
+                ssize_t r = pread(pf->fd, *scratch + got, n - got, off + (off_t) got);
+                if (r <= 0) {
+                    break;
+                }
+                got += (size_t) r;
+            }
+            if (got == n) {
+                return; // slice is now page-cache-resident; compute faults hit RAM
+            }
+        }
+    }
+    uint32_t sink = 0;
+    for (size_t off = 0; off < n; off += (size_t) pg) {
+        sink += (uint32_t) p[off];
+    }
+    atomic_fetch_add(&ggml_moe_fanout_sink, (int) (sink & 1u));
+}
+
+// drain one ctx's slices through the shared cursor; used by both the pool
+// workers and the legacy inline fanout.
+static void ggml_moe_fanout_drain(const struct ggml_moe_fanout_ctx * c,
+        char ** scratch, size_t * scratch_n) {
+    for (;;) {
+        int i = atomic_fetch_add(&c->next, 1);
+        if (i >= c->n_sl) break;
+        ggml_moe_fanout_touch_slice(&c->sl[i], c->pg, c->pf, scratch, scratch_n);
+    }
+}
