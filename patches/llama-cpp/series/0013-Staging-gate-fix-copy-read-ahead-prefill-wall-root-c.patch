+// ---- LLAMA_VK_MOE_DEVICE_STAGE --------------------------------------------
+// Prompt-width expert matmuls read weights from host-imported memory through
+// the GPU fault path, which saturates near ~1 GB/s regardless of drive. With
+// this mode the tensor is read CPU-side instead (plain sequential memcpy —
+// the kernel readahead runs at the drive's full rate), uploaded to a device
+// scratch, and the matmul binds the device copy. The memcpy for the next
+// expert node runs on a staging thread while the current node's upload and
+// compute execute on the GPU, so staging hides under the shader.
+static vk_buffer ggml_vk_create_buffer_hostmem(vk_device& device, size_t size);
+
+struct vk_moe_stage_state {
+    bool inited = false;
+    bool on = false;
+    bool broken = false;            // buffer alloc failed once; stay on the fault path
+    int parity = 0;                 // slot used by the most recent staged node
+    bool have_job = false;          // memcpy in flight or pending
+    bool job_done = true;
+    const void * job_src = nullptr; // identifies the tensor the job staged
+    size_t job_len = 0;
+    int job_slot = 0;
+    bool bind_active = false;       // current node binds the staged copy
+    int bind_slot = 0;
+    pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+    pthread_cond_t cv = PTHREAD_COND_INITIALIZER;
+    pthread_t thread;
+    bool thread_started = false;
+    vk_buffer host[2];
+    vk_buffer dev[2];
+    size_t cap[2] = {0, 0};
+};
+static vk_moe_stage_state g_moe_stage;
+
+static void * ggml_vk_moe_stage_thread(void *) {
+    for (;;) {
+        pthread_mutex_lock(&g_moe_stage.mu);
+        while (!g_moe_stage.have_job) {
+            pthread_cond_wait(&g_moe_stage.cv, &g_moe_stage.mu);
+        }
+        const void * src = g_moe_stage.job_src;
+        const size_t len = g_moe_stage.job_len;
+        const int slot = g_moe_stage.job_slot;
+        void * dst = g_moe_stage.host[slot]->ptr;
+        g_moe_stage.have_job = false;  // taken; a new kick may be queued
+        pthread_mutex_unlock(&g_moe_stage.mu);
+
+        memcpy(dst, src, len);
+
+        pthread_mutex_lock(&g_moe_stage.mu);
+        g_moe_stage.job_done = true;
+        pthread_cond_broadcast(&g_moe_stage.cv);
+        pthread_mutex_unlock(&g_moe_stage.mu);
+    }
+    return nullptr;
+}
+
+static void ggml_vk_moe_stage_ensure(vk_device& device, int slot, size_t len) {
+    if (g_moe_stage.cap[slot] >= len) {
+        return;
+    }
+    if (g_moe_stage.cap[slot] > 0) {
+        g_moe_stage.host[slot] = nullptr;  // vk_buffer_struct frees on reset
+        g_moe_stage.dev[slot] = nullptr;
+    }
+    try {
+        g_moe_stage.host[slot] = ggml_vk_create_buffer_hostmem(device, len);
+        g_moe_stage.dev[slot] = ggml_vk_create_buffer_check(device, len,
+                vk::MemoryPropertyFlagBits::eDeviceLocal);
+        g_moe_stage.cap[slot] = len;
+    } catch (const std::exception& e) {
+        // VRAM/RAM too tight for a staging slot: disable staging for this run
+        // and keep serving through the fault path instead of dying mid-graph.
+        GGML_LOG_WARN("ggml_vulkan: MoE device staging disabled, buffer alloc failed (%s)\n", e.what());
+        g_moe_stage.host[slot] = nullptr;
+        g_moe_stage.dev[slot] = nullptr;
+        g_moe_stage.cap[slot] = 0;
+        g_moe_stage.broken = true;
+    }
+}
+
+// true when the node is a prompt-width expert matmul on host-imported weights
+static bool ggml_vk_moe_stage_qualifies(const ggml_tensor * node) {
+    if (node->op != GGML_OP_MUL_MAT_ID || node->src[1] == nullptr ||
+            node->src[1]->ne[1] <= 4 || node->src[0] == nullptr) {
+        return false;
+    }
+    if (ggml_nbytes(node->src[0]) > 512ull * 1024 * 1024) {
+        return false;
+    }
+    return strstr(node->src[0]->name, "_exps") != nullptr;
+}
+
+static void ggml_vk_moe_stage_wait_done() {
+    pthread_mutex_lock(&g_moe_stage.mu);
+    while (!g_moe_stage.job_done) {
+        pthread_cond_wait(&g_moe_stage.cv, &g_moe_stage.mu);
+    }
+    pthread_mutex_unlock(&g_moe_stage.mu);
+}
+
 static void ggml_vk_mul_mat_id_q_f16(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst) {
