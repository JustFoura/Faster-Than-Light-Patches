+// ---- large-copy read-ahead (2026-10-01) ------------------------------------
+// The graph scheduler copies every expert weight from its CPU_Mapped home
+// (a plain mmap of the GGUF) into a device buffer before each prompt-pass
+// mul_mat_id — 144 tensors x ~450 MB at one-pass prefill, ~77 GB per pass.
+// Each copy runs through ggml_vk_buffer_write_2d fully synchronously, and
+// its mmap read side (queue-depth-1 page faults) sustained only ~0.9 GB/s —
+// that, not the MoE shader, is the dominant prefill wall (GPU busy ~45%,
+// CPU ~1 core during the pass; ubatch sweep read volumes 77/138/259 GB match
+// copies-per-pass exactly). Advising the kernel to page the NEXT window of
+// the file ahead of the copy cursor turns every read into a page-cache hit.
+// No tensor bytes change, so outputs stay byte-identical.
+static void ggml_vk_mmap_readahead_ahead(const void * src, size_t size) {
+    static std::mutex mu;
+    std::lock_guard<std::mutex> guard(mu);
+    struct vk_ra_map {
+        const char * base;
+        const char * end;
+        int fd;
+        off_t map_off;
+    };
+    static vk_ra_map maps[8];
+    static int maps_n = 0;
+    static long window_mb = -1;
+    if (window_mb < 0) {
+        const char * e = getenv("LLAMA_VK_COPY_READAHEAD_MB");
+        window_mb = e && e[0] ? atol(e) : 1536;
+    }
+    if (window_mb == 0) {
+        return;
+    }
+    const char * p = (const char *) src + size;
+    const vk_ra_map * m = nullptr;
+    for (int i = 0; i < maps_n; ++i) {
+        if (p >= maps[i].base && p < maps[i].end) {
+            m = &maps[i];
+            break;
+        }
+    }
+    if (m == nullptr) {
+        if (maps_n >= 8) {
+            return;
+        }
+        FILE * f = fopen("/proc/self/maps", "r");
+        if (f == NULL) {
+            return;
+        }
+        char line[1024];
+        const uintptr_t want = (uintptr_t) p;
+        while (fgets(line, sizeof(line), f)) {
+            uintptr_t lo = 0, hi = 0;
+            char perms[8] = {0};
+            unsigned long long off = 0;
+            unsigned int devmaj = 0, devmin = 0;
+            long inode = 0;
+            if (sscanf(line, "%lx-%lx %7s %llx %x:%x %li",
+                       &lo, &hi, perms, &off, &devmaj, &devmin, &inode) != 7 ||
+                    inode == 0 || perms[0] != 'r' || want < lo || want >= hi) {
+                continue;
+            }
+            const char * path = strchr(line, '/');
+            if (path == NULL) {
+                continue;
+            }
+            char pathbuf[768];
+            size_t plen = strcspn(path, "\n");
+            if (plen == 0 || plen >= sizeof(pathbuf)) {
+                continue;
+            }
+            memcpy(pathbuf, path, plen);
+            pathbuf[plen] = '\0';
+            int fd = open(pathbuf, O_RDONLY);
+            if (fd < 0) {
+                continue;
+            }
+            vk_ra_map * nm = &maps[maps_n++];
+            nm->base = (const char *) lo;
+            nm->end = (const char *) hi;
+            nm->fd = fd;
+            nm->map_off = (off_t) off;
+            m = nm;
+            break;
+        }
+        fclose(f);
+        if (m == nullptr) {
+            return;
+        }
+    }
+    const char * wstart = p;
+    const char * wend = p + (size_t) window_mb * (1ull << 20);
+    if (wend > m->end) {
+        wend = m->end;
+    }
+    if (wend > wstart) {
+        posix_fadvise(m->fd, m->map_off + (wstart - m->base), wend - wstart,
+                POSIX_FADV_WILLNEED);
+    }
+}
