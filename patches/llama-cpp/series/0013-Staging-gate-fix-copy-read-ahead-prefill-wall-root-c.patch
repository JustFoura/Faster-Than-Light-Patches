+    }
     if (!src1_uma) {
         d_Qy = src1_buf_ctx->dev_buffer;
         qy_buf_offset = vk_tensor_offset(src1) + src1->view_offs;
@@ -10831,6 +10944,89 @@ static void ggml_vk_mul_mat_id(ggml_backend_vk_context * ctx, vk_context& subctx
     ggml_tensor * src1 = dst->src[1];
     ggml_tensor * src2 = dst->src[2];
     VK_LOG_DEBUG("ggml_vk_mul_mat_id(" << src0 << ", " << src1 << ", " << src2 << ", " << dst << ")");
+    if (!g_moe_stage.inited) {
+        const char * e = getenv("LLAMA_VK_MOE_DEVICE_STAGE");
+        g_moe_stage.on = (e && e[0] == '1');
+        g_moe_stage.inited = true;
+    }
+    if (g_moe_stage.on && !g_moe_stage.broken &&
+            !ggml_vk_use_mul_mat_vec_id(cgraph, node_idx) &&
+            ggml_vk_moe_stage_qualifies(dst)) {
+        vk_buffer tmp = nullptr;
+        size_t tmpoff = 0;
+        // 10-01 fix: with --load-mode mmap the expert weights live in
+        // CPU_Mapped buffers (a plain file mmap), which the pinned_memory
+        // lookup cannot see — host_get returned null and staging silently
+        // skipped every op (major-fault counts identical on/off). Qualify on
+        // host-backed src0 instead and stage from the raw pointer, which the
+        // copies below already read.
+        bool stageable = false;
+        if (src0->buffer != nullptr &&
+                ggml_backend_buft_is_host(src0->buffer->buft)) {
+            stageable = true;
