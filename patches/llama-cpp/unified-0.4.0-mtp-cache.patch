+// ---- large-copy parallel page-in (2026-10-01) -------------------------------
+// The prefill wall, established by measurement (docs/bench-results-2026-10-01/
+// FINDINGS-EVENING.md, and the drive sweep in this repo's
+// scripts/probe-drive-rate.py):
+//
+//   * The graph scheduler copies every expert weight tensor from its
+//     CPU_Mapped mmap home into a device buffer before each prompt-pass
+//     mul_mat_id: 144 tensors x ~450 MB, ~68 GB per one-pass prefill.
+//   * That volume is IRREDUCIBLE. At top-10 of 512 experts with 14963 tokens
+//     every expert in every layer is selected ~6 times on average
+//     (P(any expert untouched) ~ 1e-129), so the scheduler's "copy only the
+//     used experts" path collapses into one whole-tensor run and copies
+//     everything. There is nothing to skip.
+//   * The copy's read side is a single-threaded memcpy faulting through the
+//     mmap at queue depth 1, which extracts ~0.80 GB/s. The same file on the
+//     same drive sustains 1.39 GB/s at depth 1 and 4.09 GB/s at depth 8
+//     (O_DIRECT saturates at 4.13 GB/s by depth 16). So the wall is queue
+//     depth, not the device.
+//
+// One-pass prefill at the 300-400 t/s target needs 1.37-1.82 GB/s sustained
+// (68 GB / 50 s and / 37 s), i.e. 34-46% of the depth-8 rate the drive has
+// already demonstrated. Depth 8 clears the whole band.
+//
+// So: issue the reads ourselves instead of hinting the kernel. fadvise
+// WILLNEED and the device-staging experiments both failed precisely because
+// they tried to fix a queue-depth problem with advice; advice does not create
+// queue depth, concurrent preads do. The bytes, the destination and the
+// submit->fence structure are all unchanged, so outputs stay byte-identical.
+//
+// This is the same shape as the decode fanout pool in ggml-cpu.c (persistent
+// worker threads, one blocking pread each, condvar wake): the proven mechanism
+// for this drive, applied to the prompt path that never had it.
+
+// Resolve a pointer inside a file-backed mapping to (fd, file offset).
+// Mirrors ggml_moe_pread_resolve() in ggml-cpu.c: walk /proc/self/maps once,
+// cache up to 8 mappings, and answer from the cache afterwards.
+struct ggml_vk_pread_map {
+    const char * base;
+    const char * end;
+    int fd;
+    off_t map_off;
+};
+
+static int ggml_vk_pread_map_resolve(const void * addr, ggml_vk_pread_map * out) {
+    static std::mutex mu;
+    static ggml_vk_pread_map maps[8];
+    static int maps_n = 0;
+
+    std::lock_guard<std::mutex> guard(mu);
+
+    const char * want = (const char *) addr;
+    for (int i = 0; i < maps_n; ++i) {
+        if (want >= maps[i].base && want < maps[i].end) {
+            *out = maps[i];
+            return 0;
+        }
+    }
+    if (maps_n >= 8) {
+        return -1;
+    }
+    FILE * f = fopen("/proc/self/maps", "r");
+    if (f == NULL) {
+        return -1;
+    }
+    char line[1024];
+    int found = -1;
+    while (fgets(line, sizeof(line), f)) {
+        uintptr_t lo = 0, hi = 0;
+        char perms[8] = {0};
+        unsigned long long off = 0;
+        unsigned int devmaj = 0, devmin = 0;
+        long inode = 0;
+        if (sscanf(line, "%lx-%lx %7s %llx %x:%x %li",
+                    &lo, &hi, perms, &off, &devmaj, &devmin, &inode) != 7 ||
+                inode == 0 || perms[0] != 'r' || want < (const char *) lo || want >= (const char *) hi) {
+            continue;
+        }
+        const char * path = strchr(line, '/');
+        if (path == NULL) {
+            continue;
+        }
+        char pathbuf[768];
+        size_t plen = strcspn(path, "\n");
+        if (plen == 0 || plen >= sizeof(pathbuf)) {
+            continue;
+        }
+        memcpy(pathbuf, path, plen);
+        pathbuf[plen] = '\0';
+        int fd = open(pathbuf, O_RDONLY);
+        if (fd < 0) {
+            continue;
+        }
+        ggml_vk_pread_map * nm = &maps[maps_n++];
+        nm->base = (const char *) lo;
+        nm->end  = (const char *) hi;
+        nm->fd   = fd;
+        nm->map_off = (off_t) off;
+        *out = *nm;
+        found = 0;
+        break;
+    }
+    fclose(f);
+    return found;
+}
+
+// One worker's share: pread [start, start+len) of the file into dst.
+struct ggml_vk_pread_chunk {
+    int fd;
+    off_t file_off;
+    uint8_t * dst;
+    size_t len;
+    int failed;
+};
+
+static void * ggml_vk_pread_worker(void * arg) {
+    ggml_vk_pread_chunk * c = (ggml_vk_pread_chunk *) arg;
+    size_t got = 0;
+    while (got < c->len) {
+        ssize_t r = pread(c->fd, c->dst + got, c->len - got, c->file_off + (off_t) got);
+        if (r <= 0) {
+            c->failed = 1;
+            return nullptr;
+        }
+        got += (size_t) r;
+    }
+    return nullptr;
+}
+
+// Page `size` bytes at `src` into `dst` with `depth` concurrent preads.
+// Returns false if the source is not a resolvable file mapping, in which case
+// the caller must fall back to its existing memcpy.
+static long g_vk_pread_calls = 0, g_vk_pread_hit = 0, g_vk_pread_fail = 0, g_vk_pread_bytes = 0;
+static bool ggml_vk_pread_parallel(const void * src, void * dst, size_t size) {
+    static long configured = -1;
+    if (configured < 0) {
+        const char * e = getenv("LLAMA_VK_COPY_PREAD_DEPTH");
+        configured = e && e[0] ? atol(e) : 8;
+    }
+    // Size floor for engaging concurrent preads. Historically 4 MiB, chosen when
+    // the stream was drained one copy at a time and thread setup had to pay for
+    // itself. Now a whole batch of up to copy_batch_max independent copies is
+    // drained concurrently (ggml_vk_drain_memcpys), so the per-call cost is
+    // amortised across copies and the floor can drop to catch the 3.4 MB
+    // average that was falling back to a plain memcpy. Measured 10-02: 4 MiB
+    // -> 177.5/193.7 t/s, 256 KiB -> 202.2/201.3 t/s, order-controlled.
+    // LLAMA_VK_COPY_PREAD_MIN_KB.
+    static long min_bytes = -1;
+    if (min_bytes < 0) {
+        const char * e = getenv("LLAMA_VK_COPY_PREAD_MIN_KB");
+        min_bytes = e && e[0] ? atol(e) * 1024 : (256ll << 10);
+    }
+    if (configured <= 1 || (long long) size < min_bytes) {
+        return false;
+    }
+    g_vk_pread_calls++;
+    int n = (int) configured;
+    if (n > 32) {
+        n = 32;
+    }
+
+    ggml_vk_pread_map m;
+    if (ggml_vk_pread_map_resolve(src, &m) != 0) {
+        return false;
+    }
+    // the whole source must live inside the one mapping
+    if ((const char *) src + size > m.end) {
+        return false;
+    }
+
+    // 4 KiB-align the split points so every chunk is a whole number of pages
+    const size_t chunk_align = 4096;
+    size_t n_chunks = size / chunk_align;
+    if (n_chunks < (size_t) n) {
+        n = (int) n_chunks;
+    }
+    if (n < 2) {
+        return false;
+    }
+    const size_t per = ((size / n) / chunk_align) * chunk_align;
+    if (per == 0) {
+        return false;
+    }
+
+    std::vector<ggml_vk_pread_chunk> chunks;
+    chunks.reserve(n);
+    std::vector<std::thread> threads;
+    threads.reserve(n - 1);
+
+    size_t done = 0;
+    for (int i = 0; i < n; ++i) {
+        size_t len = (i == n - 1) ? (size - done) : per;
+        ggml_vk_pread_chunk c;
+        c.fd = m.fd;
+        c.file_off = m.map_off + (off_t) ((const char *) src - m.base) + (off_t) done;
+        c.dst  = (uint8_t *) dst + done;
+        c.len  = len;
+        c.failed = 0;
+        chunks.push_back(c);
+        done += len;
+    }
+
+    // the calling thread takes chunk 0 rather than idling
+    ggml_vk_pread_worker(&chunks[0]);
+    for (size_t i = 1; i < chunks.size(); ++i) {
+        threads.emplace_back(ggml_vk_pread_worker, &chunks[i]);
+    }
+    for (auto & t : threads) {
+        t.join();
+    }
+
+    for (const auto & c : chunks) {
+        if (c.failed) {
+            g_vk_pread_fail++;
+            return false;
+        }
+    }
+    g_vk_pread_hit++;
+    g_vk_pread_bytes += (long) size;
+    if (g_vk_pread_hit == 1 || g_vk_pread_hit % 64 == 0) {
+        fprintf(stderr, "[copy-pread] depth=%ld hits=%ld fails=%ld paged=%.1f GB\n",
+                configured, g_vk_pread_hit, g_vk_pread_fail, g_vk_pread_bytes / 1e9);
+    }
+    return true;
+}
