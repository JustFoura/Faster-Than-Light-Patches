+    ggml_vk_copy_pool_flush(ctx, GGML_VK_FLUSH_OTHER);
+    while (!ctx->copy_inflight.empty()) {
+        ggml_vk_copy_pool_retire_oldest(ctx);
+    }
+    if (getenv("LLAMA_VK_COPY_POOL_LOG")) {
+        fprintf(stderr, "[copy-pool] acquires=%ld blocked=%ld batches=%ld avg_batch=%.1f slots=%zu\n",
