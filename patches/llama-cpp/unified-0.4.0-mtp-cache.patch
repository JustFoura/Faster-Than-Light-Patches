+// Retire the oldest in-flight batch: wait its fence, free its slots. This is
+// the ONLY place the copy path blocks, and it blocks on the batch the GPU has
+// had longest to finish — not on the copy it just issued.
+static void ggml_vk_copy_pool_retire_oldest(ggml_backend_vk_context * ctx) {
+    if (ctx->copy_inflight.empty()) {
+        return;
+    }
+    ggml_backend_vk_context::staging_batch & b = ctx->copy_inflight.front();
+    const int64_t t0 = ggml_vk_now_us();
+    VK_CHECK(ctx->device->device.waitForFences({ b.fence }, true, UINT64_MAX),
