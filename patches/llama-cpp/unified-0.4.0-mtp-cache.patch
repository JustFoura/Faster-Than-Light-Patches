+static void * ggml_vk_moe_stage_thread(void *) {
+    for (;;) {
+        pthread_mutex_lock(&g_moe_stage.mu);
+        while (!g_moe_stage.have_job) {
+            pthread_cond_wait(&g_moe_stage.cv, &g_moe_stage.mu);
+        }
+        const void * src = g_moe_stage.job_src;
+        const size_t len = g_moe_stage.job_len;
+        const int slot = g_moe_stage.job_slot;
+        void * dst = g_moe_stage.host[slot]->ptr;
+        g_moe_stage.have_job = false;  // taken; a new kick may be queued
+        pthread_mutex_unlock(&g_moe_stage.mu);
+
+        memcpy(dst, src, len);
+
+        pthread_mutex_lock(&g_moe_stage.mu);
+        g_moe_stage.job_done = true;
+        pthread_cond_broadcast(&g_moe_stage.cv);
+        pthread_mutex_unlock(&g_moe_stage.mu);
+    }
+    return nullptr;
+}
