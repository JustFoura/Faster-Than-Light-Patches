+                g_copy_pool_flush_by[GGML_VK_FLUSH_RESERVE],
+                g_copy_pool_flush_by[GGML_VK_FLUSH_BATCH_FULL],
+                g_copy_pool_flush_by[GGML_VK_FLUSH_SYNCHRONIZE],
+                g_copy_pool_flush_by[GGML_VK_FLUSH_GRAPH_COMPUTE],
+                g_copy_pool_flush_by[GGML_VK_FLUSH_EVENT_RECORD]);
