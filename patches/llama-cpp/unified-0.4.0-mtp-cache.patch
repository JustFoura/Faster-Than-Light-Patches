+    // the GPU drains the other. A batch of 1 degenerates to the per-copy submit
+    // this replaces.
+    ctx->copy_batch_max = n / 2 > 0 ? (size_t) (n / 2) : 1;
+    if (getenv("LLAMA_VK_COPY_POOL_LOG")) {
+        fprintf(stderr, "[copy-pool] slots=%d batch=%zu\n", n, ctx->copy_batch_max);
+    }
+}
