+    g_copy_pool_retire_us += ggml_vk_now_us() - t0;
+    ctx->device->device.resetFences({ b.fence });
+    ctx->device->device.destroyFence(b.fence);
+    for (size_t s : b.slots) {
+        ctx->copy_pool[s].busy = false;
+    }
+    ctx->copy_inflight.erase(ctx->copy_inflight.begin());
