+    bool inited = false;
+    bool on = false;
+    bool broken = false;            // buffer alloc failed once; stay on the fault path
+    int parity = 0;                 // slot used by the most recent staged node
+    bool have_job = false;          // memcpy in flight or pending
+    bool job_done = true;
+    const void * job_src = nullptr; // identifies the tensor the job staged
+    size_t job_len = 0;
+    int job_slot = 0;
+    bool bind_active = false;       // current node binds the staged copy
+    int bind_slot = 0;
+    pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+    pthread_cond_t cv = PTHREAD_COND_INITIALIZER;
+    pthread_t thread;
+    bool thread_started = false;
+    vk_buffer host[2];
+    vk_buffer dev[2];
+    size_t cap[2] = {0, 0};
+};
+static vk_moe_stage_state g_moe_stage;
