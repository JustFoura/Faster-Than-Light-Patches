+static atomic_int ggml_moe_fanout_sink = 0;
+
+struct ggml_moe_fanout_slice { char * p; size_t n; };
+
+struct ggml_moe_fanout_ctx {
+    struct ggml_moe_fanout_slice * sl;
+    int n_sl;
+    atomic_int next;
+    long pg;
+    // LLAMA_MOE_PREAD=1: stream slices with exact-size pread() from the model
+    // file instead of faulting the mapping. pread bypasses the file's readahead
+    // window (grown by the prompt's sequential pass; random decode-time slice
+    // faults then overshoot into neighboring experts ~4x) and still populates
+    // the page cache for the compute pass, without a 4 KiB fault storm.
+    const struct ggml_moe_pread_file * pf;
+};
+
+struct ggml_moe_pread_file {
+    const void * map_start;
+    const void * map_end;
+    int          fd;
+    off_t        map_off;
+};
+
+static struct ggml_moe_pread_file g_moe_pread_files[16];
+static int g_moe_pread_n = -1; // -1 = not yet resolved
+
+static const struct ggml_moe_pread_file * ggml_moe_pread_resolve(const void * addr) {
+    if (g_moe_pread_n < 0) {
+        g_moe_pread_n = 0;
+        FILE * f = fopen("/proc/self/maps", "r");
+        if (f) {
+            char line[1024];
+            while (g_moe_pread_n < 16 && fgets(line, sizeof(line), f)) {
+                unsigned long s, e, off;
+                char perms[8];
+                if (sscanf(line, "%lx-%lx %7s %lx", &s, &e, perms, &off) != 4 || perms[0] != 'r') {
+                    continue;
+                }
+                char * sp = strstr(line, " /");
+                if (!sp) {
+                    continue;
+                }
+                sp++;
+                sp[strcspn(sp, "\n")] = 0;
+                if (strstr(sp, " (deleted)")) {
+                    continue;
+                }
+                struct stat st;
+                if (stat(sp, &st) != 0 || st.st_size < (1 << 30)) {
+                    continue; // big file-backed mappings only (model weights)
+                }
+                int fd = open(sp, O_RDONLY);
+                if (fd < 0) {
+                    continue;
+                }
+                g_moe_pread_files[g_moe_pread_n].map_start = (const void *) (uintptr_t) s;
+                g_moe_pread_files[g_moe_pread_n].map_end   = (const void *) (uintptr_t) e;
+                g_moe_pread_files[g_moe_pread_n].fd        = fd;
+                g_moe_pread_files[g_moe_pread_n].map_off   = (off_t) off;
+                g_moe_pread_n++;
+            }
+            fclose(f);
+        }
+    }
+    for (int i = 0; i < g_moe_pread_n; ++i) {
+        if (addr >= g_moe_pread_files[i].map_start && addr < g_moe_pread_files[i].map_end) {
+            return &g_moe_pread_files[i];
+        }
+    }
+    return NULL;
+}
+
+// ---- prompt-phase expert pre-reader (LLAMA_MOE_PROMPT_PREREAD=1) ----
+// At prompt widths the expert matmuls execute on the GPU over the imported
+// host mapping, and the shaders fault expert pages as they consume them.
+// Within one layer the fault set is that layer's whole expert range (~1.3
+// GiB across gate/up/down), so issuing async WILLNEED reads for layer N+1's
+// (and N+2's) ranges while the graph computes layer N converts the random
+// fault stream into page-cache hits. One layer of reading (~0.3 s at the
+// drive's sequential rate) hides under the next layer's ~2 s wall.
+//
+// The registry fills from the mul_mat_id warmup pass (every layer's gate/up/
+// down stream through the CPU node at reserve/warmup shapes); the kick fires
+// from CPU MUL_MAT nodes, which run per layer at prompt widths only (gated
+// on the activation row count).
+static struct ggml_moe_prereg {
+    const void * base;
+    size_t len;
+    const struct ggml_moe_pread_file * pf;
+} g_moe_prereg[64][3];
+static int g_moe_prereg_layers = 0;
+
+static void ggml_moe_prereg_record(int il, int kind, const void * base, size_t len) {
+    if (il < 0 || il >= 64 || kind < 0 || kind >= 3) {
+        return;
+    }
+    if (g_moe_prereg[il][kind].base == base && g_moe_prereg[il][kind].len == len) {
+        return;
+    }
+    g_moe_prereg[il][kind].base = base;
+    g_moe_prereg[il][kind].len  = len;
+    g_moe_prereg[il][kind].pf   = ggml_moe_pread_resolve(base);
+    if (il + 1 > g_moe_prereg_layers) {
+        g_moe_prereg_layers = il + 1;
+    }
+}
+
+static void ggml_moe_preread_kick(const struct ggml_tensor * node) {
+    static int done = 0;
+    static int on = 0;
+    static long long kick_ms[64];
+    if (!done) {
+        const char * e = getenv("LLAMA_MOE_PROMPT_PREREAD");
+        on = (e && e[0] == '1');
+        done = 1;
+    }
+    if (!on || g_moe_prereg_layers == 0) {
+        return;
+    }
+    // prompt-shaped only: at decode widths the CPU kernel reads exactly via
+    // the fanout pool and readahead is deliberately off
+    if (node->src[1] == NULL || node->src[1]->ne[1] <= 4) {
+        return;
+    }
+    const char * nm = node->src[0] ? node->src[0]->name : "";
+    const char * blk = strstr(nm, "blk.");
+    if (blk == NULL) {
+        return;
+    }
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const long long now = ts.tv_sec * 1000ll + ts.tv_nsec / 1000000;
+    const int il = atoi(blk + 4);
+    for (int n = il + 1; n <= il + 2 && n < g_moe_prereg_layers; ++n) {
+        if (now - kick_ms[n] < 250) {
+            continue; // one refresh per layer quarter-wall is plenty
+        }
+        kick_ms[n] = now;
+        for (int k = 0; k < 3; ++k) {
+            const struct ggml_moe_prereg * r = &g_moe_prereg[n][k];
+            if (r->base != NULL && r->pf != NULL && r->len > 0) {
+                posix_fadvise(r->pf->fd,
+                        (off_t) (r->pf->map_off + ((const char *) r->base - (const char *) r->pf->map_start)),
+                        (off_t) r->len, POSIX_FADV_WILLNEED);
+            }
+        }
+    }
+}
+
+// page in one slice: exact-size pread when a model mapping was resolved,
+// else a one-byte-per-page touch walk to fault it in.
+static void ggml_moe_fanout_touch_slice(const struct ggml_moe_fanout_slice * s,
+        long pg, const struct ggml_moe_pread_file * pf,
+        char ** scratch, size_t * scratch_n) {
+    const char * p = s->p;
+    const size_t n = s->n;
+    if (pf) {
+        off_t off = pf->map_off + (p - (const char *) pf->map_start);
+        if (*scratch_n < n) {
+            free(*scratch);
+            *scratch = (char *) malloc(n);
+            *scratch_n = *scratch ? n : 0;
+        }
+        if (*scratch) {
+            size_t got = 0;
+            while (got < n) {
+                ssize_t r = pread(pf->fd, *scratch + got, n - got, off + (off_t) got);
+                if (r <= 0) {
+                    break;
+                }
+                got += (size_t) r;
+            }
+            if (got == n) {
+                return; // slice is now page-cache-resident; compute faults hit RAM
+            }
+        }
+    }
+    uint32_t sink = 0;
+    for (size_t off = 0; off < n; off += (size_t) pg) {
+        sink += (uint32_t) p[off];
+    }
+    atomic_fetch_add(&ggml_moe_fanout_sink, (int) (sink & 1u));
+}
+
+// drain one ctx's slices through the shared cursor; used by both the pool
+// workers and the legacy inline fanout.
+static void ggml_moe_fanout_drain(const struct ggml_moe_fanout_ctx * c,
+        char ** scratch, size_t * scratch_n) {
+    for (;;) {
+        int i = atomic_fetch_add(&c->next, 1);
+        if (i >= c->n_sl) break;
+        ggml_moe_fanout_touch_slice(&c->sl[i], c->pg, c->pf, scratch, scratch_n);
+    }
+}
+
+static void * ggml_moe_fanout_worker(void * arg) {
+    struct ggml_moe_fanout_ctx * c = (struct ggml_moe_fanout_ctx * ) arg;
+    char * scratch = NULL;
+    size_t scratch_n = 0;
+    ggml_moe_fanout_drain(c, &scratch, &scratch_n);
+    free(scratch);
+    return NULL;
+}
+
+// LLAMA_MOE_MADV_RANDOM=decode: phase-aware readahead control. Prompt-shaped
+// ops (many id rows) keep MADV_NORMAL so the one-pass expert stream reads
+// sequentially at full readahead; decode/verify-shaped ops (ids <= 4) flip every
+// registered expert mapping to MADV_RANDOM so the random 2-3 slice misses per
+// node do not drag in neighbors (measured 09-28: pure-decode io 0.9 ->
+// 0.16 GiB/tok). Flips run on phase transitions only; every moe op registers
+// its tensor range the first time it is seen. LLAMA_MOE_PREAD is gated by the
+// same phase: exact-size pread for decode/verify widths, readahead-friendly
+// touch for prompts.
+static void ggml_moe_phase_update(const void * tensor_data, size_t nbytes, bool decode_phase) {
+    struct ggml_moe_phase_range { const void * p; size_t n; };
+    #define GGML_MOE_PHASE_MAX 512
+    static struct ggml_moe_phase_range ranges[GGML_MOE_PHASE_MAX];
+    static int ranges_n = 0;
+    static int phase = -1; // -1 unset, 0 prompt, 1 decode
+    static int mode = -1;  // -1 unset, 0 off, 2 decode-phase
+
+    if (mode == -1) {
+        const char * e = getenv("LLAMA_MOE_MADV_RANDOM");
+        mode = (e && e[0] == 'd') ? 2 : 0;
+    }
+    if (mode != 2) {
+        return;
+    }
+
+    const long pg = sysconf(_SC_PAGESIZE);
+    const void * base = (const void *) ((uintptr_t) tensor_data & ~((uintptr_t) pg - 1));
+    const size_t len = nbytes + ((const char *) tensor_data - (const char *) base);
+
+    bool registered = false;
+    for (int i = 0; i < ranges_n; ++i) {
+        if (ranges[i].p == base) {
+            registered = true;
+            break;
+        }
+    }
+    if (!registered && ranges_n < GGML_MOE_PHASE_MAX) {
+        ranges[ranges_n].p = base;
+        ranges[ranges_n].n = len;
+        ranges_n++;
+    }
+
+    const int want = decode_phase ? 1 : 0;
+    if (want == phase) {
+        return;
+    }
+    for (int i = 0; i < ranges_n; ++i) {
+        madvise((void *) ranges[i].p, ranges[i].n, want ? MADV_RANDOM : MADV_NORMAL);
+    }
+    phase = want;
+}
+
+// ---- persistent async fanout pool -----------------------------------------
+//
+// One pool per process. Jobs enter a fixed ring; a ring slot is only reused
+// once every pool worker has passed the job (its active count drained), so a
+// worker can always dereference jobs[done % RING] safely and the submitter at
+// that slot blocks on cv_free until then. Pool threads process jobs strictly
+// in submission order, which keeps the page-in stream file-offset ordered.
+
+#define GGML_MOE_FANOUT_POOL_MAX 32
+#define GGML_MOE_FANOUT_RING     8
+
+struct ggml_moe_fanout_job {
+    struct ggml_moe_fanout_ctx c;
+    atomic_int active;   // pool workers that have not passed this job yet
+    bool       in_use;
+    // GGML_MOE_NODE_LOG: submit and drain timestamps (CLOCK_MONOTONIC ns)
+    // to expose the IO/compute phase split per mul_mat_id node.
+    long long    submit_ns;
+    atomic_long  done_ns;
+};
+
+static struct {
+    pthread_mutex_t mu;
+    pthread_cond_t  cv_work;
+    pthread_cond_t  cv_free;
+    pthread_t       tid[GGML_MOE_FANOUT_POOL_MAX];
+    int             n_threads;
+    bool            started;
+    bool            disabled;  // pool start failed; stay on the legacy path
+    bool            shutdown;
+    bool            node_log;  // GGML_MOE_NODE_LOG=1: per-node phase lines
+    bool            pipe;      // LLAMA_MOE_FANOUT_PIPE=1: two worker groups
+                               // drain alternate jobs (pipeline across jobs)
+    int             gsize[2];  // workers per group
+    int             submitted;
+    struct ggml_moe_fanout_job jobs[GGML_MOE_FANOUT_RING];
+} g_moe_pool = {
+    .mu      = PTHREAD_MUTEX_INITIALIZER,
+    .cv_work = PTHREAD_COND_INITIALIZER,
+    .cv_free = PTHREAD_COND_INITIALIZER,
+};
+
+static void * ggml_moe_fanout_pool_worker(void * arg) {
+    // Worker group: 0 for every worker in legacy mode (g=0 makes the index
+    // math below identical to the old per-worker `done` sequence); t%2 when
+    // pipelining, so two independent groups drain alternate jobs and the
+    // pread stream stays deep across job boundaries instead of emptying
+    // between one job's last slice and the next job's submit.
+    const int g = (int) (intptr_t) arg;
+    // pipelining is decided once at pool start, before any worker spawns;
+    // legacy mode (pipe=false, all workers g=0) must index jobs 0,1,2,...
+    // exactly as before — the 2*done+g stride is only for the two-group mode
+    const bool pipe = g_moe_pool.pipe;
+    char * scratch = NULL;
+    size_t scratch_n = 0;
+    int done = 0; // jobs this worker has fully passed (of its group)
+    pthread_mutex_lock(&g_moe_pool.mu);
+    for (;;) {
+        // NOTE: an earlier version let the workers run `depth` jobs ahead of the
+        // submitter to deepen the pread queue. It deadlocks at depth > 1 and the
+        // reason is structural, not a typo: ggml_moe_fanout_pool_submit publishes
+        // one job and the caller then blocks in ggml_moe_pread_wait until that
+        // job's active hits 0, so a second job is never in flight for a worker
+        // to run ahead to. Depth has to come from submitting AHEAD — which is
+        // what the one-layer-ahead miss prefetch (LLAMA_MOE_MISS_PREFETCH) does,
+        // by handing the pool the next layer's saved slice list before that
+        // layer's own op submits. Do not re-add a worker-side depth knob.
+        struct ggml_moe_fanout_job * j;
+        while (!g_moe_pool.shutdown &&
+                (pipe ? 2 * done + g : done) >= g_moe_pool.submitted) {
+            pthread_cond_wait(&g_moe_pool.cv_work, &g_moe_pool.mu);
+        }
+        if (g_moe_pool.shutdown &&
+                (pipe ? 2 * done + g : done) >= g_moe_pool.submitted) {
+            break;
+        }
+        j = &g_moe_pool.jobs[(pipe ? 2 * done + g : done) % GGML_MOE_FANOUT_RING];
+        pthread_mutex_unlock(&g_moe_pool.mu);
+        ggml_moe_fanout_drain(&j->c, &scratch, &scratch_n);
+        pthread_mutex_lock(&g_moe_pool.mu);
+        done++;
+        if (atomic_fetch_sub(&j->active, 1) == 1) {
+            if (g_moe_pool.node_log) {
+                struct timespec ts;
+                clock_gettime(CLOCK_MONOTONIC, &ts);
+                atomic_store(&j->done_ns, (long long) ts.tv_sec * 1000000000ll + ts.tv_nsec);
+            }
+            free(j->c.sl);
+            j->c.sl   = NULL;
+            j->in_use = false;
+            pthread_cond_broadcast(&g_moe_pool.cv_free);
+        }
+    }
+    pthread_mutex_unlock(&g_moe_pool.mu);
+    free(scratch);
+    return NULL;
+}
+
+// take ownership of sl on success; returns false when the pool is unavailable
+// (then the caller runs the legacy inline fanout and owns sl). job_out (may be
+// NULL) receives the ring slot the job was placed in, for the node-phase log.
+static bool ggml_moe_fanout_pool_submit(struct ggml_moe_fanout_slice * sl,
+        int n_sl, long pg, const struct ggml_moe_pread_file * pf, int n_threads,
+        struct ggml_moe_fanout_job ** job_out) {
+    if (n_threads > GGML_MOE_FANOUT_POOL_MAX) {
+        n_threads = GGML_MOE_FANOUT_POOL_MAX;
+    }
+    pthread_mutex_lock(&g_moe_pool.mu);
+    if (g_moe_pool.disabled) {
+        pthread_mutex_unlock(&g_moe_pool.mu);
+        return false;
+    }
+    if (!g_moe_pool.started) {
+        const char * pe = getenv("LLAMA_MOE_FANOUT_PIPE");
+        // one worker cannot split into two groups (a job in the empty group
+        // would start with active == 0 and never free its ring slot)
+        g_moe_pool.pipe = (pe && pe[0] == '1') && n_threads >= 2;
+        g_moe_pool.started = true;
+        g_moe_pool.n_threads = n_threads;
+        int started = 0;
+        for (int t = 0; t < n_threads; ++t) {
+            const int g = g_moe_pool.pipe ? t % 2 : 0;
+            if (pthread_create(&g_moe_pool.tid[t], NULL, ggml_moe_fanout_pool_worker,
+                        (void *) (intptr_t) g) == 0) {
+                started++;
+                g_moe_pool.gsize[g_moe_pool.pipe ? t % 2 : 0]++;
+            }
+        }
+        if (started == 0) {
+            g_moe_pool.disabled = true;
+            pthread_mutex_unlock(&g_moe_pool.mu);
+            return false;
+        }
+        g_moe_pool.n_threads = started;
+        fprintf(stderr, "[moe-fanout] threads=%d pipe=%d ring=%d\n",
+                started, (int) g_moe_pool.pipe, GGML_MOE_FANOUT_RING);
+    }
+    struct ggml_moe_fanout_job * j = &g_moe_pool.jobs[g_moe_pool.submitted % GGML_MOE_FANOUT_RING];
+    while (j->in_use) {
+        pthread_cond_wait(&g_moe_pool.cv_free, &g_moe_pool.mu);
+    }
+    if (!g_moe_pool.node_log) {
+        const char * e = getenv("GGML_MOE_NODE_LOG");
+        g_moe_pool.node_log = (e && e[0] == '1');
+    }
+    if (g_moe_pool.node_log) {
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        j->submit_ns = (long long) ts.tv_sec * 1000000000ll + ts.tv_nsec;
+    }
+    j->c.sl   = sl;
+    j->c.n_sl = n_sl;
+    j->c.pg   = pg;
+    j->c.pf   = pf;
+    atomic_init(&j->c.next, 0);
+    const int g_j = g_moe_pool.pipe ? (g_moe_pool.submitted % 2) : 0;
+    atomic_store_explicit(&j->active, g_moe_pool.gsize[g_j], memory_order_seq_cst);
+    j->in_use = true;
+    g_moe_pool.submitted++;
+    if (job_out) {
+        *job_out = j;
+    }
+    pthread_cond_broadcast(&g_moe_pool.cv_work);
+    pthread_mutex_unlock(&g_moe_pool.mu);
+    return true;
+}
+
+// Pread sequencing (LLAMA_MOE_PREAD at decode/verify widths): the persistent
+// pool drains a job's exact-size preads asynchronously; without sequencing,
+// the compute threads race the preads and fault the same miss pages from disk
+// at 4 KiB granularity under MADV_RANDOM - measured ~2x read amplification on
+// the miss stream (494 vs ~250 MiB/tok) with ~30% of the disk time wasted.
+// Thread 0 publishes a generation + job pointer every mul_mat_id op; every
+// compute thread waits for the published job (active == 0) before touching
+// slice data. The barrier at the top of the next op orders generation reuse:
+// no thread can observe generation N+1 before finishing its own wait for N.
+static _Atomic(struct ggml_moe_fanout_job *) g_moe_pread_wait_job;
+static _Atomic(unsigned long long)           g_moe_pread_wait_gen;
+static __thread unsigned long long           g_moe_pread_seen;
+
+static void ggml_moe_pread_publish(bool dispatched_pread, struct ggml_moe_fanout_job * job) {
+    atomic_store_explicit(&g_moe_pread_wait_job, dispatched_pread ? job : NULL,
+            memory_order_release);
+    atomic_fetch_add_explicit(&g_moe_pread_wait_gen, 1, memory_order_release);
+}
+
+// LLAMA_MOE_PREAD_WAIT=0 removes the barrier entirely: compute threads fault the
+// miss pages themselves while the pool is still preading them. That is the
+// ~2x read amplification the barrier was added to prevent, so OFF is the A/B
+// arm and not a proposed setting — it exists to measure whether the barrier is
+// what caps decode's read rate (1.42 GB/s) or whether the amplification costs
+// more than the overlap gains. Anything other than exactly "0" keeps the
+// original behaviour.
+static int ggml_moe_pread_wait_enabled(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char * e = getenv("LLAMA_MOE_PREAD_WAIT");
+        on = !(e && e[0] == '0' && e[1] == '\0');
+    }
+    return on;
+}
+
+static void ggml_moe_pread_wait(void) {
+    if (!ggml_moe_pread_wait_enabled()) {
+        return;
+    }
+    const unsigned long long gen =
+        atomic_load_explicit(&g_moe_pread_wait_gen, memory_order_acquire);
+    if (gen == g_moe_pread_seen) {
+        return;
+    }
+    g_moe_pread_seen = gen;
+    struct ggml_moe_fanout_job * j =
+        atomic_load_explicit(&g_moe_pread_wait_job, memory_order_acquire);
+    if (!j) {
+        return;
+    }
+    while (atomic_load_explicit(&j->active, memory_order_acquire) != 0) {
+        sched_yield();
+    }
+}
+
+// GGML_MOE_MMAP_DONTNEED: release routed expert pages after the op computes
+// them (bounded page-cache window for SSD-offloaded experts). Inactive unless
+// set to exactly "1".
+static bool ggml_cpu_mmid_page_release_enabled(void) {
+    const char * value = getenv("GGML_MOE_MMAP_DONTNEED");
+    return value != NULL && value[0] == '1' && value[1] == '\0';
+}
+
+// MADV_DONTNEED on a private anonymous mapping zeroes the pages, so only ever
+// drop ranges that live in a file-backed mapping. Each distinct base pointer
+// is checked once against /proc/self/maps and the verdict is cached; every
+// expert tensor of a GGUF shares one mapping, so the common case is one walk
+// per tensor for the whole process lifetime. Caches are read-only after init
+// and the single writer runs on the main compute thread, so no lock is needed.
+static bool ggml_cpu_range_is_file_backed(const void * addr, size_t size) {
+    struct ggml_cpu_fb_entry { const void * key; bool val; };
+    static struct ggml_cpu_fb_entry cache[512];
+    static size_t cache_n = 0;
+    static bool cache_full = false;
+
+    if (!cache_full) {
+        for (size_t i = 0; i < cache_n; ++i) {
+            if (cache[i].key == addr) {
+                return cache[i].val;
+            }
+        }
+    } else {
+        for (size_t i = 0; i < 512; ++i) {
+            if (cache[i].key == addr) {
+                return cache[i].val;
+            }
+        }
+    }
+
+    bool file_backed = false;
+    FILE * f = fopen("/proc/self/maps", "r");
+    if (f) {
