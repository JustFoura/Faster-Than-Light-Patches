+    std::thread([ranges]() {
+        const long   pg    = sysconf(_SC_PAGESIZE);
+        const size_t chunk = 64UL << 20;
+        for (const auto & r : *ranges) {
+            const uintptr_t base = (uintptr_t) r.first & ~((uintptr_t) pg - 1);
+            const size_t    len  = r.second + ((uintptr_t) r.first - base);
+            for (size_t off = 0; off < len; off += chunk) {
+                madvise((void *) (base + off), std::min(chunk, len - off), MADV_WILLNEED);
+            }
+        }
+        in_flight = false;
+    }).detach();
