+// Optional Linux read-ahead for expert matrices selected by the current graph.
+// This is an immediate demand hint, not a learned route profile or placement policy.
+static bool ggml_cpu_mmid_demand_prefetch_enabled(void) {
+#if defined(__linux__)
+    const char * value = getenv("GGML_MOE_MMAP_WILLNEED");
+    return value != NULL && value[0] == '1' && value[1] == '\0';
+#else
+    return false;
+#endif
+}
+
+static void ggml_cpu_mmid_demand_prefetch(
+        const struct ggml_tensor * src0,
+        const int64_t * matrix_row_counts,
+        const int64_t n_experts) {
+#if defined(__linux__)
+    if (!ggml_cpu_mmid_demand_prefetch_enabled()) {
+        return;
+    }
+
+    const long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) {
+        return;
+    }
+
+    // Coalesce adjacent selected experts to keep syscall overhead bounded.
+    for (int64_t first = 0; first < n_experts;) {
+        if (matrix_row_counts[first] == 0) {
+            ++first;
+            continue;
+        }
+
+        int64_t end = first + 1;
+        while (end < n_experts && matrix_row_counts[end] != 0) {
+            ++end;
+        }
+
+        const uintptr_t begin_addr = (uintptr_t) src0->data + first * src0->nb[2];
+        const uintptr_t end_addr = (uintptr_t) src0->data + end * src0->nb[2];
+        const uintptr_t page_begin = begin_addr - begin_addr % (uintptr_t) page_size;
+        const uintptr_t page_end = ((end_addr + (uintptr_t) page_size - 1) / (uintptr_t) page_size) * (uintptr_t) page_size;
+
+        if (page_end > page_begin) {
+            (void) madvise((void *) page_begin, page_end - page_begin, MADV_WILLNEED);
+        }
+
+        first = end;
+    }
+#else
+    (void) src0;
+    (void) matrix_row_counts;
+    (void) n_experts;
+#endif
+}
